{
  "auto-formatter": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "format-file",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "stop-gate",
        "timeout": 30
      }
    ]
  }
}
