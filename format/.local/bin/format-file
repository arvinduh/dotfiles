#!/usr/bin/env bash
# Formats a single file using the canonical formatter for its filetype.
# Supports CLI invocation ($1), git pre-commit, and Antigravity PostToolUse hooks (stdin JSON).
set -euo pipefail

file="${1:-}"

# If no argument is provided, attempt to parse Antigravity PostToolUse hook payload from stdin
if [[ -z "$file" ]]; then
  if [[ ! -t 0 ]]; then
    payload=$(cat)
    file=$(echo "$payload" | python3 -c "import sys, json
try:
  d = json.load(sys.stdin)
  print(d.get('toolCall', {}).get('args', {}).get('TargetFile', ''))
except Exception:
  pass" 2>/dev/null || true)
    # PostToolUse hook expects empty JSON on stdout
    echo "{}"
  fi
fi

if [[ -z "$file" || ! -f "$file" ]]; then
  exit 0
fi

case "$file" in
  *.rs)
    if command -v rustfmt >/dev/null 2>&1; then
      rustfmt +nightly "$file" >/dev/null 2>&1 || rustfmt "$file" >/dev/null 2>&1 || true
    fi
    ;;
  *.py)
    if command -v ruff >/dev/null 2>&1; then
      ruff format "$file" >/dev/null 2>&1 || true
      ruff check --fix --quiet "$file" >/dev/null 2>&1 || true
    fi
    ;;
  *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx)
    if command -v clang-format >/dev/null 2>&1; then
      clang-format -i "$file" >/dev/null 2>&1 || true
    fi
    ;;
  *.lua)
    if command -v stylua >/dev/null 2>&1; then
      stylua "$file" >/dev/null 2>&1 || true
    fi
    ;;
  *.toml)
    if command -v taplo >/dev/null 2>&1; then
      taplo format "$file" >/dev/null 2>&1 || true
    fi
    ;;
  *.sh|*.bash)
    if command -v shfmt >/dev/null 2>&1; then
      shfmt -w -i 2 -ci -bn "$file" >/dev/null 2>&1 || true
    fi
    ;;
  *.md|*.json|*.jsonc|*.yaml|*.yml|*.ts|*.tsx|*.js|*.jsx)
    if command -v prettier >/dev/null 2>&1; then
      prettier --write "$file" >/dev/null 2>&1 || true
    fi
    ;;
esac
