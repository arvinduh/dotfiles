# Global shellcheck config: the Google Shell Style Guide rules shellcheck
# can check but leaves off by default. A repo's own .shellcheckrc wins.
enable=require-variable-braces    # SC2250: "${var}", not $var
enable=require-double-brackets    # SC2292: [[ ]], not [ ]
enable=avoid-nullary-conditions   # SC2244: [[ -n "${x}" ]], not [[ "${x}" ]]
enable=check-extra-masked-returns # SC2312: failures hidden in $(...)
enable=deprecate-which            # SC2230: command -v, not which
external-sources=true
