#!/usr/bin/env bash
# Formats one file with the canonical formatter for its type: Rust, Python,
# C/C++, TOML, JSON, YAML, Markdown.
# Supports CLI invocation ($1), git pre-commit, and PostToolUse hooks (stdin
# JSON) from both Antigravity and Claude Code.
# Lint findings the formatter could not fix go to stderr. As a Claude Code hook
# the script then exits 2, which hands them to the agent that made the edit.
set -euo pipefail

file="${1:-}"
claude=false

# No argument: this is a PostToolUse hook. The two harnesses put the edited
# path in different fields:
#   Antigravity  {"toolCall": {"args": {"TargetFile": ...}}}
#   Claude Code  {"tool_input": {"file_path": ...}}
if [[ -z "$file" ]]; then
  if [[ ! -t 0 ]]; then
    payload=$(cat)
    file=$(echo "$payload" | python3 -c "import sys, json
try:
  d = json.load(sys.stdin)
  args = d.get('toolCall', {}).get('args', {})
  tool_input = d.get('tool_input', {})
  print(args.get('TargetFile') or tool_input.get('file_path') or '')
except Exception:
  pass" 2>/dev/null || true)
    [[ $payload != *'"tool_input"'* ]] || claude=true
    # PostToolUse hook expects empty JSON on stdout
    echo "{}"
  fi
fi

if [[ -z "$file" || ! -f "$file" ]]; then
  exit 0
fi

have() { command -v "$1" >/dev/null 2>&1; }

# Every formatter is optional: a missing one leaves the file as it was.
findings=""
case "$file" in
  *.rs)
    have rustfmt && { rustfmt +nightly "$file" || rustfmt "$file"; } ;;
  *.py)
    if have ruff; then
      ruff check --fix --quiet "$file" || true
      ruff format "$file"
      findings=$(ruff check --quiet --output-format concise "$file" 2>&1) ||
        true
    fi
    ;;
  *.c | *.cc | *.cpp | *.cxx | *.h | *.hh | *.hpp | *.hxx)
    have clang-format && clang-format -i "$file" ;;
  *.toml)
    have taplo && taplo format "$file" ;;
  *.json | *.jsonc | *.yaml | *.yml)
    have prettier && prettier --write "$file" ;;
  *.md)
    have prettier && prettier --write "$file"
    if have markdownlint-cli2; then
      # markdownlint-cli2 never searches parent directories for config, so
      # pass the global one unless the repo carries its own.
      root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null ||
        dirname "$file")
      global="$HOME/.config/markdownlint/.markdownlint-cli2.jsonc"
      config=()
      compgen -G "$root/.markdownlint*" >/dev/null || [[ ! -f $global ]] ||
        config=(--config "$global")
      (cd "$root" && markdownlint-cli2 --fix "${config[@]}" "$file")
    fi
    ;;
esac >/dev/null 2>&1 || true

if [[ -n $findings ]]; then
  echo "$findings" >&2
  ! $claude || exit 2
fi
