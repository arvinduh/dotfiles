# ~/.config/git/config
#
# Identity is NOT here. It lives in ~/.config/git/local, which is gitignored,
# so this repo stays publishable without committing your email to a public
# repo where it gets scraped. install.sh creates it interactively.
[include]
  path = local

[init]
  defaultBranch = main

[core]
  editor = nvim
  pager = delta
  autocrlf = input          # WSL: never write CRLF into the repo
  excludesfile = ~/.config/git/ignore
  hooksPath = ~/.config/git/hooks
  fsmonitor = true
  untrackedCache = true

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true           # n / N to jump between diff hunks
  line-numbers = true
  hyperlinks = true
  side-by-side = false
  file-style = bold yellow
  file-decoration-style = none
  hunk-header-decoration-style = blue box ul

[merge]
  conflictstyle = zdiff3    # shows the common ancestor — far easier to resolve
  tool = nvimdiff

[diff]
  algorithm = histogram     # better rename/move detection than myers
  colorMoved = default
  mnemonicPrefix = true
  renames = copies

[push]
  default = simple
  autoSetupRemote = true    # `git push` on a new branch just works
  followTags = true

[pull]
  rebase = true             # linear history by default

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[rerere]
  enabled = true            # remember conflict resolutions and replay them
  autoupdate = true

[branch]
  sort = -committerdate     # most recent first in `git branch`

[column]
  ui = auto

[commit]
  verbose = true            # show the diff in the commit message editor

[status]
  showUntrackedFiles = all
  submoduleSummary = true

[log]
  date = iso

[help]
  autocorrect = prompt

[alias]
  s = status --short --branch
  l = log --oneline --graph --decorate -20
  ll = log --graph --pretty=format:'%C(auto)%h%d %s %C(dim)(%cr) <%an>%Creset'
  last = log -1 HEAD --stat
  unstage = restore --staged
  undo = reset --soft HEAD~1
  amend = commit --amend --no-edit
  wip = !git add -A && git commit -m 'wip'
  cleanup = !git branch --merged | grep -v '\\*\\|main\\|master' | xargs -r git branch -d
  root = rev-parse --show-toplevel
