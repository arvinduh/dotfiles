#!/usr/bin/env bash
# Git global pre-commit hook: enforces canonical formatting on all staged files.
set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [[ -z "$staged_files" ]]; then
  exit 0
fi

export PATH="$HOME/.local/bin:$PATH"

if ! command -v format-file >/dev/null 2>&1; then
  exit 0
fi

while IFS= read -r file; do
  if [[ -f "$file" ]]; then
    format-file "$file"
    git add "$file"
  fi
done <<< "$staged_files"
